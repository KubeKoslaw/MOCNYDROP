        </mxCell>
        <mxCell id="receipt" value="Istnieje potwierdzenie&lt;br/&gt;tego request_id?" style="html=1;whiteSpace=wrap;fillColor=#fef3c7;strokeColor=#475569;fontColor=#243449;fontSize=14;fontFamily=Helvetica;rhombus;" vertex="1" parent="1">
